{
  "name": "@travelta/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e",
    "lint": "eslint .",
    "e2e": "playwright test",
    "e2e:smoke": "playwright test --project=desktop e2e/smoke",
    "e2e:functional": "playwright test --project=desktop --project=mobile e2e/services e2e/customer",
    "e2e:roles": "playwright test --project=desktop --project=service e2e/admin e2e/agency e2e/supplier e2e/security",
    "e2e:lifecycle": "playwright test --project=desktop e2e/lifecycle e2e/finance",
    "e2e:responsive": "playwright test --project=desktop --project=desktop-1920 --project=tablet-landscape --project=tablet-portrait --project=mobile-430 --project=mobile-390 --project=mobile-375 --project=mobile e2e/responsive e2e/a11y",
    "e2e:cross-browser": "playwright test --project=firefox --project=webkit",
    "e2e:report": "playwright show-report e2e-report",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.6",
    "@tanstack/react-query": "5.107.1",
    "@travelta/api-client": "workspace:*",
    "@travelta/contracts": "workspace:*",
    "@travelta/design-tokens": "workspace:*",
    "@travelta/domain": "workspace:*",
    "@travelta/i18n": "workspace:*",
    "@travelta/schemas": "workspace:*",
    "@travelta/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "idb-keyval": "6.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.73.0",
    "next": "16.4.6",
    "next-intl": "4.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.92.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@travelta/eslint-config": "workspace:*",
    "@travelta/tsconfig": "workspace:*",
    "@types/leaflet": "1.9.20",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
