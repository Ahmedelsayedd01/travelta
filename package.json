{
  "name": "travelta",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "turbo run dev --filter=@travelta/web",
    "dev:mobile": "turbo run dev --filter=@travelta/mobile",
    "build:web": "turbo run build --filter=@travelta/web",
    "export:mobile": "turbo run export --filter=@travelta/mobile",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check": "turbo run typecheck lint test",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
